pkgname=kickit
version=0.1.0
revision=1
makedepends="cargo git"
short_desc="A robust & simple init system"
maintainer="h4dynn <h4dynn@github.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/h4dynn/kickit"

do_fetch()
{
  git clone https://github.com/h4dynn/kickit.git "$wrksrc"
}

do_build()
{
  cargo build --release
}

do_install()
{
  mkdir -vpm0755 "$DESTDIR/usr/bin" \
                  "$DESTDIR/usr/lib/kickit/service" \
                  "$DESTDIR/usr/lib/kickit/target"

  install -vm0755 ./target/release/kickit "$DESTDIR/usr/lib/kickit/kickit"
  install -vm0755 ./target/release/ktctl "$DESTDIR/usr/bin/ktctl"
  install -vm0755 ./src/service-helpers/agetty.sh "$DESTDIR/usr/lib/kickit/agetty.sh"
  #install -vm0755 ./src/service-helpers/udev.sh "$DESTDIR/usr/lib/kickit/udev.sh"
}
