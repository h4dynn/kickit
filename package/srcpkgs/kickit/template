pkgname=kickit
version=0.1.2
revision=1
makedepends="rustup git"
short_desc="A robust & simple init system"
maintainer="h4dynn <h4dynn@github.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/h4dynn/kickit"

do_fetch()
{
  git clone https://github.com/h4dynn/kickit.git "$wrksrc"
}

pre_build()
{
  rustup-init -y -t x86_64-unknown-linux-musl
}

do_build()
{
  . ~/.cargo/env
  cargo build --release --target x86_64-unknown-linux-musl
}

do_install()
{
  mkdir -vpm0755 "$DESTDIR/usr/bin" \
                  "$DESTDIR/usr/lib/kickit/service" \
                  "$DESTDIR/usr/lib/kickit/target"

  install -vm0755 ./target/x86_64-unknown-linux-musl/release/kickit "$DESTDIR/usr/lib/kickit/kickit"
  install -vm0755 ./target/x86_64-unknown-linux-musl/release/ktctl "$DESTDIR/usr/bin/ktctl"
  install -vm0755 ./src/service-helpers/agetty.sh "$DESTDIR/usr/lib/kickit/agetty.sh"
  install -vm0755 ./src/service-helpers/udev.sh "$DESTDIR/usr/lib/kickit/udev.sh"

  while read service
  do {
    install -vm0644 "$service" "$DESTDIR/usr/lib/kickit/service/${service##*/}"
  }
  done \
    < <(find ./services -maxdepth 1 -type f -name '*.toml')

  cd "$DESTDIR/usr/bin"
  ln -s ktctl poweroff
  ln -s ktctl reboot
  ln -s ../lib/kickit/kickit init
}
